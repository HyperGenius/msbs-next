{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv sync (backend)",
            "type": "shell",
            "command": "uv sync",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            }
        },
        {
            "label": "Backend (Uvicorn)",
            "type": "shell",
            "command": "uv run uvicorn main:app --reload",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "dev-servers",
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Frontend (npm)",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "group": "dev-servers"
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Alembic upgrade head",
            "type": "shell",
            "command": "uv run alembic upgrade head",
            "problemMatcher": [],
            "presentation": {
                "group": "dev-servers",
            },
            "options": {
                "cwd": "${workspaceFolder}/backend"
            }
        },
        {
            "label": "Alembic check heads",
            "type": "shell",
            "command": "uv run alembic heads --verbose",
            "problemMatcher": [],
            "presentation": {
                "group": "dev-servers",
            },
            "options": {
                "cwd": "${workspaceFolder}/backend"
            }
        },
        {
            "label": "Pre-commit run all files",
            "type": "shell",
            "command": "uv run --project backend pre-commit run --all-files",
            "problemMatcher": [],
            "presentation": {
                "group": "test-runners"
            }
        },
        {
            "label": "Pytest all tests",
            "type": "shell",
            "command": "uv run pytest",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "group": "test-runners"
            }
        },
        {
            "label": "Run Storybook",
            "type": "shell",
            "command": "npm run storybook",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            }
        },
        {
            "label": "Run Admin Tool",
            "type": "shell",
            "command": "npm run dev",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/admin-tool"
            }
        },
        {
            "label": "Run Vitest",
            "type": "shell",
            "command": "npx vitest run",
            "problemMatcher": [],
            "presentation": {
                "group": "test-runners"
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            }
        },
        {
            "label": "GCloud Auth Login",
            "type": "shell",
            "command": "gcloud auth login",
            "problemMatcher": [],
            "presentation": {
                "group": "terraform",
                "panel": "dedicated"
            }
        },
        {
            "label": "GCloud Auth Application Login MSBS Project",
            "type": "shell",
            "command": "source ${workspaceFolder}/backend/.env && gcloud auth application-default login --project=${MSBS_GCP_PROJECT_ID}",
            "problemMatcher": [],
            "presentation": {
                "group": "terraform",
                "panel": "dedicated"
            }
        },
        {
            "label": "Delete Merged Branches",
            "type": "shell",
            "command": "git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs git branch -d",
            "problemMatcher": [],
            "presentation": {
                "group": "git-helpers",
                "panel": "dedicated"
            }
        }
    ]
}