# Backend API URL
# ローカル開発: http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Admin API Key（backend/.env の ADMIN_API_KEY と一致させること）
NEXT_PUBLIC_ADMIN_API_KEY=your_admin_api_key_here

# ローカルシミュレータ（/local-sim）。省略時は上記の既定値
# 世代・ロスターの読み込み元（既定: リポジトリ直下の battle_logs/local_sim）
# LOCAL_SIM_DIR=
# 再生・比較で開く frontend の URL（既定: http://localhost:3000）
# NEXT_PUBLIC_DEV_SIM_URL=http://localhost:3000
