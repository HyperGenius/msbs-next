# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/msbs_next

# CORS Configuration
# 本番環境のVercelドメインをカンマ区切りで指定
# 例: ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-preview.vercel.app
ALLOWED_ORIGINS=

# Battle Log Cloud Storage (Issue #493)
# バトルリプレイ用生ログのオフロード先GCSバケット名。
# Cloud Runランタイムサービスアカウントに対象バケットへの
# storage.objects.get / storage.objects.create 権限が必要（署名付きURLは使わないため
# IAM Credentials API の signBlob 権限は不要）。
BATTLE_LOG_GCS_BUCKET=

# Local Battle Simulator (Issue #610)
# ローカルシミュレータ（python -m scripts.simulation.local_sim）が本番DBを読むための接続文字列。
# SELECT 権限だけの Neon ロールを使う。未設定ならエラーで終了し、NEON_DATABASE_URL は使わない。
# 作成手順は docs/features/local-battle-simulator.md を参照。
NEON_READONLY_DATABASE_URL=
